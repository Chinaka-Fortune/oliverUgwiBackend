# Production Environment Variables Example
# Set these in your hosting environment (Render, Heroku, etc.)
# DO NOT COMMIT REAL PASSWORDS TO GITHUB

# A secret string for signing cookies/sessions
SECRET_KEY=generate_a_secure_random_string

# Your production database URL (e.g., Supabase PostgreSQL URL)
DATABASE_URL=postgresql://user:password@host/dbname

# Secret key for signing JWT tokens
JWT_SECRET_KEY=generate_another_random_secret

# URL of your deployed frontend (to allow CORS requests)
FRONTEND_URL=https://your-frontend-domain.vercel.app

PORT=5000
DEBUG=False
